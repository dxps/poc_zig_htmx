# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=northstar
PG_PASSWORD=northstar
PG_DB=northstar

# Default administrator, created only when the email does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Generate a long random value for non-development environments
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_SECURE_COOKIE=false
